# Copy to .env for a local Postgres from docker-compose.yml.
# When neither DATABASE_URL nor POSTGRES_HOST is set, Django uses SQLite.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=instruction_presenter
POSTGRES_USER=instruction_presenter
POSTGRES_PASSWORD=instruction_presenter

# Or a single URL (takes priority over POSTGRES_*):
# DATABASE_URL=postgres://instruction_presenter:instruction_presenter@localhost:5432/instruction_presenter
